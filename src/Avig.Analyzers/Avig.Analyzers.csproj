<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      TargetFramework MUST be netstandard2.0.

      The analyzer is loaded into the compiler process (csc / VBCSCompiler), not into the
      consumer's app, and that process runs on .NET Framework when Visual Studio is the
      host. NuGet also places the analyzer DLL at analyzers/dotnet/cs — a path with no TFM
      dimension at all, so there is no mechanism for shipping different DLLs to different
      consumers.

      A net10.0 analyzer is therefore silently never loaded. The consumer's project is
      welcome to be net10.0; that has nothing to do with this line.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Deterministic build with embedded symbols + SourceLink (built into SDK 8+).
      No .snupkg: IncludeBuildOutput=false means the SDK's symbol packaging never runs, so
      a symbol package would come out empty. DebugType=embedded instead puts the PDB inside
      the DLL, which the target below already packs.
    -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Avig.Analyzers</PackageId>
    <Version>1.2.0</Version>
    <Title>Avig.Analyzers</Title>
    <Description>Project-independent Roslyn rules for C#: formatting, naming, documentation requirements, readability, async hygiene and auth hygiene. AVIG0001-AVIG0024, eight with a code fix. The rules report as suggestions until you raise the severity yourself in .editorconfig; four of the nineteen are warnings out of the box.</Description>
    <PackageTags>analyzers;roslyn;codequality;code-analysis;formatting;documentation;security;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.1.0 - six new rules: AVIG0014 (blocking call on a task), AVIG0015 (awaited call drops a CancellationToken), AVIG0020 (local time instead of UTC), AVIG0021 (log message built instead of templated), AVIG0022 (public member hands out a mutable collection) and AVIG0023 (TODO comment without a tracking reference). Two of them have a code fix; AVIG0014, AVIG0015 and AVIG0023 are warnings out of the box, the rest suggestions. 1.0.0 - twelve rules extracted from Medusa.Analyzers and de-Medusa-fied.</PackageReleaseNotes>

    <!--
      IncludeBuildOutput=false is what decides whether the package works at all: an
      analyzer must NOT end up in lib/, because then the consumer references the Roslyn
      assembly as ordinary code instead of running it at compile time. The package
      installs without complaint and then does nothing. The DLL goes into
      analyzers/dotnet/cs/ through the PackAnalyzerAssembly target below instead, and
      publish.ps1 verifies that it landed there.

      DevelopmentDependency=true stops the dependency from flowing on to whoever
      references the consumer's package in turn. The rules are a build-time concern, not
      something that should travel out into an app.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Deliberately pinned to 4.11.0. An analyzer must reference a Roslyn version equal to
      or older than the one the consumer's compiler hosts. 4.11.0 reaches down to
      SDK 8.0.4xx / VS 17.11; bumping it would lock out everyone not on the latest SDK
      without giving us a single API we need.

      Workspaces (not just ...CSharp) is required for code fix providers and pulls in
      Microsoft.CodeAnalysis.CSharp.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- One README, two jobs: GitHub renders it in the root, NuGet inside the package. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!--
      avig-analyzers.editorconfig ships inside the package but is not applied
      automatically: severity is the consumer's decision, and a package that quietly turns
      formatting rules into errors in somebody else's repository would be overstepping.
      The file is a template to copy into your own .editorconfig.
    -->
    <None Include="avig-analyzers.editorconfig" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PackAnalyzerAssembly" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
