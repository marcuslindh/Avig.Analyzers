<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The tests deliberately contain badly formatted code as string literals. -->
    <NoWarn>$(NoWarn);CA1707;IDE0055;CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      The ...Testing.XUnit packages are marked obsolete; DefaultVerifier in the base
      packages is the replacement and works with any test framework.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />
    <!--
      Must be pinned. The test framework references Workspaces >= 1.0.1 and without this
      line could resolve to something far older than what the analyzer is built against,
      with confusing load failures as the result.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both an analyzer and a real reference, which is why both attributes are here.
      OutputItemType="Analyzer" is what makes the rules run on this project's own code -
      the package eats its own dog food, and a rule that is unbearable to live with shows
      up here first. ReferenceOutputAssembly="true" keeps the assembly as an ordinary
      reference as well, because the tests instantiate the analyzer classes
      (typeof(BlankLineBeforeReturnAnalyzer)); with the analyzer attribute alone the
      assembly is only handed to the compiler and the types cannot be reached from test
      code.

      The analyzer project itself cannot do this: csc would load the very DLL the build is
      about to overwrite. Its source is checked by the same rules through the .editorconfig
      when it is compiled here as a project reference.
    -->
    <ProjectReference Include="..\..\src\Avig.Analyzers\Avig.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
