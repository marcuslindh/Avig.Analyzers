<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Testerna innehaller avsiktligt felformaterad kod som stranglitteraler. -->
    <NoWarn>$(NoWarn);CA1707;IDE0055;CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      De ...Testing.XUnit-paketen ar markta obsolete; DefaultVerifier i baspaketen ar
      ersattaren och fungerar med vilket testramverk som helst.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />
    <!--
      Maste pinnas. Testramverket refererar Workspaces >= 1.0.1 och skulle utan den har
      raden kunna losas till nagot langt aldre an det analysatorn byggs mot, med
      forvirrande laddningsfel som foljd.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      VANLIG ProjectReference, INTE OutputItemType="Analyzer".
      Testerna instansierar analysatorklasserna (typeof(BlankLineBeforeReturnAnalyzer)) och
      maste darfor ha assemblyn som en riktig referens. Med OutputItemType="Analyzer"
      skickas den bara till kompilatorn och typerna gar inte att na fran testkoden.
    -->
    <ProjectReference Include="..\..\src\Avig.Analyzers\Avig.Analyzers.csproj" />
  </ItemGroup>

</Project>
