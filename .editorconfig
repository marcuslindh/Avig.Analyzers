root = true

[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = false

# Projektkonvention arvd fran kallan: explicita bool-jamforelser (x == true / x == false).
# Reglerna nedan vill skriva om dem och far vara tysta.
dotnet_diagnostic.RCS1033.severity = none
dotnet_diagnostic.S1125.severity = none
dotnet_diagnostic.IDE0075.severity = none

# GenerateDocumentationFile ar av i analyzerprojektet — CS1591 ska inte klaga.
dotnet_diagnostic.CS1591.severity = none

[tests/**/*.cs]
# Testkod innehaller avsiktligt felformaterad kod som stranglitteraler.
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.CA1707.severity = none
